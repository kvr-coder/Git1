{
  "expo": {
    "name": "timeoff",
    "slug": "timeoff",
    "version": "1.1.0",
    "orientation": "portrait",
    "scheme": "timeoff",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "platforms": ["ios", "android"],
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0b1220"
    },
    "android": {
      "package": "com.kvrcoder.timeoff",
      "adaptiveIcon": {
        "backgroundColor": "#0b1220"
      }
    },
    "ios": {
      "bundleIdentifier": "com.kvrcoder.timeoff",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSUserNotificationUsageDescription": "Timeoff sends you instant alerts when your kid requests more screen time or completes a chore."
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        { "color": "#3b82f6" }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e8e50263-c2c5-471b-ba0a-1cdb67c4349b"
    },
    "extra": {
      "eas": {
        "projectId": "e8e50263-c2c5-471b-ba0a-1cdb67c4349b"
      }
    }
  }
}
